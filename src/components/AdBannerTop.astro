---
/**
 * Banner de topo. Reserva a altura do bloco desde o primeiro paint para
 * não causar Cumulative Layout Shift (CLS) quando o AdSense carregar.
 *
 * Ativação por variáveis de ambiente do build:
 *   PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
 *   PUBLIC_ADSENSE_SLOT_TOP=1234567890   (ID do bloco de anúncio)
 * Com as variáveis ausentes, renderiza o placeholder neutro.
 */
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT_TOP;
const ativo = Boolean(client && slot);
const alturaClasse = 'min-h-[100px] md:min-h-[90px]';
---

{
  ativo ? (
    <div class={`mx-auto w-full max-w-5xl px-6 ${alturaClasse}`}>
      <ins
        class="adsbygoogle block"
        style="display: block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  ) : (
    <div
      class={`mx-auto flex w-full max-w-5xl items-center justify-center px-6 ${alturaClasse}`}
      data-ad-slot="banner-topo"
      aria-hidden="true"
    >
      <div class="flex h-full w-full items-center justify-center rounded-lg border border-dashed border-line py-6">
        <span class="text-xs tracking-widest text-ink-muted uppercase">Espaço publicitário</span>
      </div>
    </div>
  )
}
