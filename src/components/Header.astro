---
const { pathname } = Astro.url;
const ativo = (base: string) => pathname.startsWith(base);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-3" aria-label="Códigos Jogos — página inicial">
      <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true" class="cut-pequeno">
        <rect width="64" height="64" fill="#b9f53c"></rect>
        <text
          x="32" y="44" text-anchor="middle" font-family="monospace" font-size="34" font-weight="bold" fill="#0d120a"
        >&gt;_</text>
      </svg>
      <span class="font-display text-lg font-semibold tracking-wide uppercase">Códigos Jogos</span>
    </a>
    <nav aria-label="Navegação principal" class="flex items-center gap-1 font-mono text-xs tracking-wider uppercase">
      <a
        href="/codigos/"
        class:list={[
          'cut-pequeno px-3 py-1.5 transition-colors hover:bg-surface hover:text-volt',
          ativo('/codigos') ? 'text-volt' : 'text-ink-muted',
        ]}
      >Jogos</a>
      <a
        href="/gratis/"
        class:list={[
          'cut-pequeno px-3 py-1.5 transition-colors hover:bg-surface hover:text-volt',
          ativo('/gratis') ? 'text-volt' : 'text-ink-muted',
        ]}
      >Grátis</a>
      <a
        href="/sobre/"
        class:list={[
          'cut-pequeno px-3 py-1.5 transition-colors hover:bg-surface hover:text-volt',
          ativo('/sobre') ? 'text-volt' : 'text-ink-muted',
        ]}
      >Sobre</a>
    </nav>
  </div>
</header>
