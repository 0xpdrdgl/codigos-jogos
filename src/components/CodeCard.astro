---
import type { Codigo } from '../lib/types';

interface Props {
  codigo: Codigo;
  expirado?: boolean;
}

const { codigo, expirado = false } = Astro.props;
const data = new Date(codigo.ultimaVerificacao).toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'short',
});
---

<div
  class:list={[
    'cut flex flex-wrap items-center justify-between gap-3 border px-4 py-3.5',
    expirado ? 'border-line bg-surface opacity-50' : 'border-line bg-surface',
  ]}
>
  <div class="flex items-center gap-3">
    <code
      class:list={[
        'bg-canvas px-3 py-1.5 font-mono text-sm font-bold tracking-[0.2em]',
        expirado ? 'text-ink-muted line-through' : 'text-volt',
      ]}
    ><span class="mr-1.5 select-none opacity-50">&gt;</span>{codigo.codigo}</code>
    {
      expirado ? (
        <span class="cut-pequeno bg-no-bg px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest text-no-fg uppercase">
          expirado
        </span>
      ) : (
        <span class="cut-pequeno bg-ok-bg px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest text-ok-fg uppercase">
          ativo
        </span>
      )
    }
  </div>
  <div class="flex items-center gap-4 text-sm text-ink-muted">
    {codigo.recompensa && <span class="text-xs">{codigo.recompensa}</span>}
    <span class="font-mono text-xs">verific. {data}</span>
    {
      !expirado && (
        <button
          type="button"
          data-codigo={codigo.codigo}
          class="cut-pequeno border border-volt-dim px-3 py-1.5 font-mono text-[11px] font-bold tracking-widest text-volt uppercase transition-colors hover:border-volt hover:bg-volt hover:text-canvas"
        >
          <span data-rotulo>copiar</span>
        </button>
      )
    }
  </div>
</div>
