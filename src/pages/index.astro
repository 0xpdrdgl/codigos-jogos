---
import BaseLayout from '../layouts/BaseLayout.astro';
import { jogos } from '../lib/games';
import { ativosPorJogo, codigos, atualizadoEm } from '../lib/codes';
import { dataLonga } from '../lib/dates';

const ativos = ativosPorJogo();
const totalAtivos = codigos.filter((c) => c.status === 'ativo').length;
const atualizado = atualizadoEm();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Códigos Jogos',
    url: Astro.site?.href,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: jogos.map((j, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Códigos ${j.nome}`,
      url: new URL(`/codigos/${j.slug}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Códigos de jogos hoje: resgates ativos e tutoriais"
  description={`Códigos de resgate de ${jogos.map((j) => j.nome).join(', ')} e mais jogos, verificados e atualizados automaticamente. Lista de ativos, expirados e o passo a passo oficial do resgate.`}
  canonical="/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-6 pt-16" data-revelar>
    <p class="text-sm font-medium tracking-widest text-ink-muted uppercase">Atualizado todo dia</p>
    <h1 class="mt-3 font-display text-4xl leading-tight tracking-tight sm:text-5xl">
      Códigos de resgate de jogos, sem código falso.
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
      Coletamos automaticamente os canais oficiais e as comunidades de cada jogo.
      Todo código entra aqui só depois de revisão manual — com a data da última
      verificação à mostra.
    </p>
    <div class="mt-8 flex flex-wrap gap-6 text-sm">
      <div>
        <span class="font-display text-3xl">{jogos.length}</span>
        <span class="ml-1 text-ink-muted">jogos monitorados</span>
      </div>
      <div>
        <span class="font-display text-3xl">{totalAtivos}</span>
        <span class="ml-1 text-ink-muted">códigos ativos agora</span>
      </div>
      {
        atualizado && (
          <div>
            <span class="font-display text-3xl">·</span>
            <span class="ml-2 text-ink-muted">base atualizada em {dataLonga(atualizado)}</span>
          </div>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-14" aria-label="Jogos monitorados" data-revelar>
    <h2 class="font-display text-2xl tracking-tight">Jogos monitorados</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        jogos.map((jogo) => {
          const n = ativos.get(jogo.slug) ?? 0;
          return (
            <a
              href={`/codigos/${jogo.slug}/`}
              class="group rounded-lg border border-line bg-surface px-5 py-5 transition-colors hover:border-ink-muted"
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <span class="block text-lg font-medium">{jogo.nome}</span>
                  <span class="mt-0.5 block text-xs text-ink-muted">{jogo.editora}</span>
                </div>
                <span
                  class:list={[
                    'rounded-full px-3 py-1 text-xs font-medium',
                    n > 0 ? 'bg-ok-bg text-ok-fg' : 'bg-canvas text-ink-muted',
                  ]}
                >
                  {n > 0 ? `${n} ativo${n > 1 ? 's' : ''}` : 'sem ativos'}
                </span>
              </div>
              <span class="mt-3 block text-sm text-ink-muted underline decoration-line underline-offset-4 group-hover:text-ink">
                ver códigos e como resgatar
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-16" aria-label="Como funciona" data-revelar>
    <h2 class="font-display text-2xl tracking-tight">Como funciona</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        [
          {
            titulo: 'Coleta automática',
            texto: 'Robôs leem as fontes oficiais e comunidades de cada jogo de hora em hora e detectam códigos novos.',
          },
          {
            titulo: 'Revisão manual',
            texto: 'Cada candidato é aprovado ou rejeitado por uma pessoa antes de entrar na lista — nada de código inventado.',
          },
          {
            titulo: 'Resgate oficial',
            texto: 'O resgate é sempre no site ou app oficial da editora. Nunca pedimos sua senha nem seus dados de conta.',
          },
        ].map((passo, i) => (
          <div class="rounded-lg border border-line bg-surface px-5 py-5">
            <span class="font-mono text-sm text-ink-muted">0{i + 1}</span>
            <h3 class="mt-2 text-base font-medium">{passo.titulo}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-muted">{passo.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
