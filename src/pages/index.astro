---
import BaseLayout from '../layouts/BaseLayout.astro';
import { jogos } from '../lib/games';
import { ativosPorJogo, codigos, atualizadoEm } from '../lib/codes';
import { dataLonga } from '../lib/dates';

const ativos = ativosPorJogo();
const totalAtivos = codigos.filter((c) => c.status === 'ativo').length;
const atualizado = atualizadoEm();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Códigos Jogos',
    url: Astro.site?.href,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: jogos.map((j, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Códigos ${j.nome}`,
      url: new URL(`/codigos/${j.slug}/`, Astro.site).href,
    })),
  },
];
---

<BaseLayout
  title="Códigos de jogos hoje: resgates ativos e tutoriais"
  description={`Códigos de resgate de ${jogos.map((j) => j.nome).join(', ')} e mais jogos, verificados e atualizados automaticamente. Lista de ativos, expirados e o passo a passo oficial do resgate.`}
  canonical="/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-6 pt-20" data-revelar>
    <p class="flex items-center gap-2.5 font-mono text-xs font-bold tracking-[0.3em] text-volt uppercase">
      <span class="ponto-volt" aria-hidden="true"></span>
      atualizado todo dia
    </p>
    <h1 class="mt-5 font-display text-5xl font-bold leading-[1.05] tracking-tight uppercase sm:text-6xl">
      Códigos de jogos<br />
      <span class="text-volt">que funcionam.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
      Bots varrem as fontes oficiais e as comunidades de cada jogo de hora em hora.
      Cada código passa por revisão humana antes de entrar na lista — com a data da
      última verificação à mostra.
    </p>
    <div class="mt-10 flex flex-wrap gap-3 font-mono text-xs tracking-wider uppercase">
      <div class="cut-pequeno border border-line bg-surface px-4 py-2.5">
        <span class="text-xl font-bold text-volt">{jogos.length}</span>
        <span class="ml-2 text-ink-muted">jogos monitorados</span>
      </div>
      <div class="cut-pequeno border border-line bg-surface px-4 py-2.5">
        <span class="text-xl font-bold text-volt">{totalAtivos}</span>
        <span class="ml-2 text-ink-muted">códigos ativos</span>
      </div>
      {
        atualizado && (
          <div class="cut-pequeno border border-line bg-surface px-4 py-2.5">
            <span class="text-ink-muted">últ. verificação · {dataLonga(atualizado)}</span>
          </div>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-16" aria-label="Jogos monitorados" data-revelar>
    <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// jogos monitorados</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        jogos.map((jogo) => {
          const n = ativos.get(jogo.slug) ?? 0;
          return (
            <a
              href={`/codigos/${jogo.slug}/`}
              class="group cut border border-line bg-surface px-5 py-5 transition-colors hover:border-volt-dim"
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <span class="block font-display text-xl font-semibold tracking-wide uppercase group-hover:text-volt">
                    {jogo.nome}
                  </span>
                  <span class="mt-0.5 block font-mono text-xs text-ink-muted">{jogo.editora}</span>
                </div>
                <span
                  class:list={[
                    'flex items-center gap-2 font-mono text-xs tracking-wider uppercase',
                    n > 0 ? 'text-volt' : 'text-ink-muted',
                  ]}
                >
                  {n > 0 && <span class="ponto-volt" aria-hidden="true" />}
                  {n > 0 ? `${n} ativo${n > 1 ? 's' : ''}` : 'sem ativos'}
                </span>
              </div>
              <span class="mt-3 block font-mono text-xs tracking-wider text-ink-muted uppercase group-hover:text-volt">
                ver códigos →
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-16" aria-label="Como funciona" data-revelar>
    <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// como funciona</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {
        [
          {
            titulo: 'Coleta automática',
            texto: 'Robôs leem as fontes oficiais e comunidades de cada jogo de hora em hora e detectam códigos novos.',
          },
          {
            titulo: 'Revisão manual',
            texto: 'Cada candidato é aprovado ou rejeitado por uma pessoa antes de entrar na lista — nada de código inventado.',
          },
          {
            titulo: 'Resgate oficial',
            texto: 'O resgate é sempre no site ou app oficial da editora. Nunca pedimos sua senha nem seus dados de conta.',
          },
        ].map((passo, i) => (
          <div class="cut border border-line bg-surface px-5 py-5">
            <span class="font-mono text-sm font-bold text-volt">0{i + 1}</span>
            <h3 class="mt-2 font-display text-base font-semibold tracking-wide uppercase">{passo.titulo}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{passo.texto}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
