---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeCard from '../../components/CodeCard.astro';
import Faq from '../../components/Faq.astro';
import AdInArticle from '../../components/AdInArticle.astro';
import { jogos } from '../../lib/games';
import { doJogo, atualizadoEm } from '../../lib/codes';
import { dataCurta, dataLonga } from '../../lib/dates';
import type { Jogo } from '../../lib/types';

export function getStaticPaths() {
  return jogos.map((jogo) => ({ params: { jogo: jogo.slug }, props: { jogo } }));
}

interface Props {
  jogo: Jogo;
}

const { jogo } = Astro.props;
const { ativos, expirados } = doJogo(jogo.slug);
const atualizado = atualizadoEm(jogo.slug);
const hoje = dataCurta();
const outrosJogos = jogos.filter((j) => j.slug !== jogo.slug);

const title =
  ativos.length > 0
    ? `Códigos ${jogo.nome} hoje (${hoje}): ${ativos.length} ativo${ativos.length > 1 ? 's' : ''}`
    : `Códigos ${jogo.nome} hoje (${hoje}): lista completa`;
const description = `Códigos de ${jogo.nome} ativos${
  atualizado ? `, verificados em ${dataLonga(atualizado)}` : ''
}: ${ativos.length} ativo${ativos.length !== 1 ? 's' : ''} e ${expirados.length} expirado${
  expirados.length !== 1 ? 's' : ''
}. Resgate oficial e passo a passo completo.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Códigos', item: new URL('/codigos/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: jogo.nome, item: new URL(`/codigos/${jogo.slug}/`, Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: jogo.faq.map((p) => ({
      '@type': 'Question',
      name: p.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: p.resposta },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={`/codigos/${jogo.slug}/`} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-6 pt-10">
    <Breadcrumbs itens={[{ nome: 'Códigos', href: '/codigos/' }, { nome: jogo.nome, href: `/codigos/${jogo.slug}/` }]} />

    <header class="mt-6" data-revelar>
      <p class="flex items-center gap-2.5 font-mono text-xs font-bold tracking-[0.3em] text-volt uppercase">
        <span class="ponto-volt" aria-hidden="true"></span>
        {ativos.length > 0 ? `${ativos.length} código${ativos.length !== 1 ? 's' : ''} ativo${ativos.length !== 1 ? 's' : ''}` : 'monitorando'}
      </p>
      <h1 class="mt-4 font-display text-5xl font-bold tracking-tight uppercase">Códigos de {jogo.nome}</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">
        {atualizado && <>Última verificação em {dataLonga(atualizado)}. </>}
        Códigos de {jogo.nome} têm formato {jogo.palavrasFormato}.
      </p>
    </header>

    <section class="mt-10" aria-label="Códigos ativos" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// ativos</h2>
      <div class="mt-4 space-y-3">
        {
          ativos.length === 0 ? (
            <p class="cut border border-dashed border-line px-4 py-6 text-center font-mono text-sm text-ink-muted">
              // nenhum código ativo — os novos entram aqui assim que passam pela revisão.<br />
              <a class="text-volt underline underline-offset-4" href={`/codigos/${jogo.slug}/como-resgatar/`}>veja o tutorial de resgate</a>
              {' '}para estar pronto quando sair.
            </p>
          ) : (
            ativos.map((codigo) => <CodeCard codigo={codigo} />)
          )
        }
      </div>
    </section>

    <AdInArticle />

    <section aria-label="Como resgatar" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// como resgatar em {jogo.nome}</h2>
      <ol class="mt-4 space-y-2.5">
        {
          jogo.passosResgate.map((passo, i) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-muted">
              <span class="cut-pequeno mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center border border-volt-dim font-mono text-[11px] font-bold text-volt">
                {i + 1}
              </span>
              {passo}
            </li>
          ))
        }
      </ol>
      <p class="mt-5 text-sm">
        <a
          href={`/codigos/${jogo.slug}/como-resgatar/`}
          class="font-mono text-xs tracking-wider text-volt uppercase underline underline-offset-4"
        >tutorial completo →</a>
        <span class="mx-3 text-line">|</span>
        <a
          href={jogo.resgateOficial}
          rel="nofollow noopener noreferrer"
          class="font-mono text-xs tracking-wider text-ink-muted uppercase underline underline-offset-4 hover:text-volt"
        >página oficial de resgate ↗</a>
      </p>
    </section>

    {
      expirados.length > 0 && (
        <section class="mt-12" aria-label="Códigos expirados" data-revelar>
          <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-ink-muted uppercase">// expirados recentemente</h2>
          <p class="mt-2 text-sm text-ink-muted">
            Histórico para conferir se aquele código que você achou já venceu.
          </p>
          <div class="mt-4 space-y-3">
            {expirados.slice(0, 10).map((codigo) => <CodeCard codigo={codigo} expirado />)}
          </div>
        </section>
      )
    }

    <section class="mt-12" aria-label="Perguntas frequentes" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// perguntas frequentes</h2>
      <div class="mt-4">
        <Faq perguntas={jogo.faq} />
      </div>
    </section>

    <section class="mt-12" aria-label="Outros jogos" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// outros jogos</h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wider uppercase">
        {
          outrosJogos.map((j) => (
            <li>
              <a href={`/codigos/${j.slug}/`} class="text-ink-muted underline underline-offset-4 hover:text-volt">
                {j.nome}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
