---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { jogos } from '../../lib/games';
import { ativosPorJogo, doJogo } from '../../lib/codes';

const ativos = ativosPorJogo();
---

<BaseLayout
  title="Todos os jogos com códigos de resgate"
  description="Lista completa dos jogos monitorados: códigos ativos, expirados e o tutorial oficial de resgate de cada um."
  canonical="/codigos/"
>
  <section class="mx-auto max-w-5xl px-6 pt-10" data-revelar>
    <Breadcrumbs itens={[{ nome: 'Códigos', href: '/codigos/' }]} />
    <h1 class="mt-6 font-display text-4xl tracking-tight">Jogos com códigos de resgate</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Cada jogo tem uma página com os códigos ativos, os expirados recentes e o
      passo a passo do resgate no site oficial.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        jogos.map((jogo) => {
          const n = ativos.get(jogo.slug) ?? 0;
          const { expirados } = doJogo(jogo.slug);
          return (
            <a
              href={`/codigos/${jogo.slug}/`}
              class="rounded-lg border border-line bg-surface px-5 py-5 transition-colors hover:border-ink-muted"
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <span class="block text-lg font-medium">{jogo.nome}</span>
                  <span class="mt-0.5 block text-xs text-ink-muted">
                    {jogo.editora}
                    {expirados.length > 0 && ` · ${expirados.length} expirado${expirados.length > 1 ? 's' : ''}`}
                  </span>
                </div>
                <span
                  class:list={[
                    'rounded-full px-3 py-1 text-xs font-medium',
                    n > 0 ? 'bg-ok-bg text-ok-fg' : 'bg-canvas text-ink-muted',
                  ]}
                >
                  {n > 0 ? `${n} ativo${n > 1 ? 's' : ''}` : 'sem ativos'}
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
