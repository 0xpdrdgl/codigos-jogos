---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faq from '../../../components/Faq.astro';
import AdInArticle from '../../../components/AdInArticle.astro';
import { jogos } from '../../../lib/games';
import { doJogo, atualizadoEm } from '../../../lib/codes';
import { dataLonga } from '../../../lib/dates';
import type { Jogo } from '../../../lib/types';

export function getStaticPaths() {
  return jogos.map((jogo) => ({ params: { jogo: jogo.slug }, props: { jogo } }));
}

interface Props {
  jogo: Jogo;
}

const { jogo } = Astro.props;
const { ativos } = doJogo(jogo.slug);
const atualizado = atualizadoEm(jogo.slug);

const title = `Como resgatar códigos em ${jogo.nome}: passo a passo oficial`;
const description = `Tutorial completo para resgatar códigos de ${jogo.nome} ${
  jogo.resgateInGame ? 'no jogo ou ' : ''
}no site oficial da ${jogo.editora}. ${ativos.length} código${
  ativos.length !== 1 ? 's' : ''
} ativo${ativos.length !== 1 ? 's' : ''} agora.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `Como resgatar códigos em ${jogo.nome}`,
    step: jogo.passosResgate.map((passo, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      text: passo,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Códigos', item: new URL('/codigos/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: jogo.nome, item: new URL(`/codigos/${jogo.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 4, name: 'Como resgatar', item: new URL(`/codigos/${jogo.slug}/como-resgatar/`, Astro.site).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={`/codigos/${jogo.slug}/como-resgatar/`} jsonLd={jsonLd} ogType="article">
  <article class="mx-auto max-w-5xl px-6 pt-10">
    <Breadcrumbs
      itens={[
        { nome: 'Códigos', href: '/codigos/' },
        { nome: jogo.nome, href: `/codigos/${jogo.slug}/` },
        { nome: 'Como resgatar', href: `/codigos/${jogo.slug}/como-resgatar/` },
      ]}
    />

    <header class="mt-6" data-revelar>
      <p class="font-mono text-xs font-bold tracking-[0.3em] text-volt uppercase">// tutorial</p>
      <h1 class="mt-4 font-display text-5xl font-bold tracking-tight uppercase">Como resgatar em {jogo.nome}</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">
        O resgate de {jogo.nome} é feito {jogo.resgateInGame ? 'dentro do jogo ou ' : ''}
        na página oficial da {jogo.editora} — nunca em sites de terceiros que peçam
        sua senha.
      </p>
    </header>

    <section class="mt-10" aria-label="Passo a passo" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// passo a passo</h2>
      <ol class="mt-4 space-y-2.5">
        {
          jogo.passosResgate.map((passo, i) => (
            <li class="flex items-start gap-3 leading-relaxed">
              <span class="cut-pequeno mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center border border-volt-dim font-mono text-[11px] font-bold text-volt">
                {i + 1}
              </span>
              <span>{passo}</span>
            </li>
          ))
        }
      </ol>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={jogo.resgateOficial}
          rel="nofollow noopener noreferrer"
          class="cut-pequeno bg-volt px-5 py-2.5 font-mono text-xs font-bold tracking-widest text-canvas uppercase transition-opacity hover:opacity-85"
        >abrir resgate oficial ↗</a>
        <a
          href={`/codigos/${jogo.slug}/`}
          class="cut-pequeno border border-line px-5 py-2.5 font-mono text-xs font-bold tracking-widest text-ink-muted uppercase transition-colors hover:border-volt-dim hover:text-volt"
        >
          ver {ativos.length > 0 ? `${ativos.length} ativo${ativos.length !== 1 ? 's' : ''}` : 'códigos'}
        </a>
      </div>
    </section>

    <AdInArticle />

    <section aria-label="Formato dos códigos" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// formato do código</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">
        Os códigos de {jogo.nome} têm formato {jogo.palavrasFormato}. Se o que você
        encontrou não segue esse formato, provavelmente não é um código de resgate —
        ou é golpe.
      </p>
      {
        atualizado && (
          <p class="mt-3 font-mono text-xs text-ink-muted">
            última verificação da lista: {dataLonga(atualizado)}
          </p>
        )
      }
    </section>

    <section class="mt-12" aria-label="Perguntas frequentes" data-revelar>
      <h2 class="font-mono text-sm font-bold tracking-[0.25em] text-volt uppercase">// perguntas frequentes</h2>
      <div class="mt-4">
        <Faq perguntas={jogo.faq} />
      </div>
    </section>
  </article>
</BaseLayout>
