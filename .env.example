# Toda variavel referenciada no codigo precisa aparecer aqui.
# Falta de uma derruba a dimensao de documentacao.

# URL canônica do site usada em meta tags, Open Graph e sitemap.
# No Cloudflare Pages, defina SITE_URL nas variáveis de ambiente do build.
SITE_URL=https://codigos-jogos.pages.dev

# AdSense — usamos apenas os anúncios automáticos do Google, então basta
# o client (o script vai no <head>); não há blocos manuais nem slots.
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Aprovação de códigos no Telegram (script `npm run approve`).
# Bot criado no @BotFather; o token e o chat ficam SÓ no .env local.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_APPROVAL_CHAT_ID=123456789

# Canal público que recebe os códigos aprovados (o bot precisa ser admin).
# TELEGRAM_CHANNEL_ID=@seu_canal

# Extração da recompensa do código por LLM (opcional). Qualquer API compatível
# com OpenAI serve; o free tier do OpenRouter ou do Gemini cobre o volume.
# Sem chave, os candidatos entram na aprovação sem recompensa preenchida.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
